# Copy to a local .env that is NEVER committed.
# All secrets live outside the repo: box env, VPS /etc/daily/*.env, or SSH keys.

# --- timezone ---
# All daily schedules are Asia/Shanghai (UTC+8).
TZ=Asia/Shanghai

# --- paths on the shared box ---
DIGESTS_ROOT=/workspace/digests
DAILY_PORTAL_ROOT=/workspace/daily-portal
DESIGN_ROOT=/workspace/inspo/web/design

# --- VPS (placeholder only; fill in locally) ---
# SSH: ssh -i "$DAILY_SSH_KEY" root@"$DAILY_VPS"
DAILY_VPS=<VPS_HOST>
DAILY_SSH_KEY=~/.ssh/vps_jidadiao
# On the original box a host alias `ssh vps` may already exist.

# Preference DB is on the VPS, not in this repo.
PREFS_DB=/srv/daily/data/prefs.db

# daily-api token: only on the VPS at /etc/daily/api.env (mode 600).
# The collector SSHes into the VPS and sources that file there.
# DAILY_API_TOKEN=

# Optional GitHub token for higher search rate limits (collectors). Prefer leaving unset.
# GITHUB_TOKEN=

# Do not put Worker secrets, linux.do User API keys, or any private key material here.
